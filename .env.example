# Alef Broker Platform — environment variables
#
# Copy to `.env.local` (Next.js convention) and fill with real values.
# `.env.local` is gitignored — never commit real keys.
#
# Where to find these: Supabase project dashboard → Settings → API.
# OpenAI key: https://platform.openai.com/api-keys

# --- Supabase ---
# Public — safe to expose in the browser.
# Use the modern "publishable" key (sb_publishable_...) for new apps. Supabase
# recommends it over the legacy anon JWT because it can be rotated independently
# of the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Server-only — full DB access. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- OpenAI (Ask Alef AI assistant) ---
# Server-only — used by /app/api/ask-alef route handler.
OPENAI_API_KEY=sk-your-openai-key-here

# --- Demo broker (PROJECT_PLAN 2.1 — real auth, demo affordance) ---
# Credentials for the /welcome "Continue as Layla" button. The auth.users
# row + matching brokers.user_id link are provisioned by the
# add_real_auth_link_brokers_provision_demo migration. Rotate by changing
# this AND updating the password in Supabase Dashboard → Authentication.
DEMO_BROKER_EMAIL=layla@alef-demo.com
DEMO_BROKER_PASSWORD=AlefDemo2026!
