# Alef Broker Platform — environment variables
#
# Copy to `.env.local` (Next.js convention) and fill with real values.
# `.env.local` is gitignored — never commit real keys.
#
# Where to find these: Supabase project dashboard → Settings → API.
# OpenAI key: https://platform.openai.com/api-keys

# --- Supabase ---
# Public — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — full DB access. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- OpenAI (Ask Alef AI assistant) ---
# Server-only — used by /app/api/ask-alef route handler.
OPENAI_API_KEY=sk-your-openai-key-here
